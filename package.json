{
  "name": "trends-mcp",
  "version": "0.1.0",
  "description": "MCP server that fetches the latest Google Trends data and adds it to the question sent to Claude Code or Cursor.",
  "type": "module",
  "bin": {
    "trends-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-trends",
    "claude-code",
    "cursor"
  ],
  "author": "yzafar2003",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzafar2003/Trends-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
